# DIAL-Det: Arrhenius server settings and detection inputs.
# Copy this file to a private location, fill in the dataset paths, then use:
# DIAL_ENV_FILE=/absolute/path/coco.env bash submit_dialdet_arrhenius.sh export
# DIAL_ENV_FILE=/absolute/path/coco.env bash submit_dialdet_arrhenius.sh full
# This is a trusted Bash configuration, sourced only when explicitly selected.
# The : "${NAME:=default}" form preserves a nonempty command-line environment override.

# Actual account, storage allocation, environment and modules from your template.
: "${DIAL_ACCOUNT:=naiss2025-5-643-gpu}"
: "${DIAL_PARTITION:=gpu}"
: "${DIAL_BASE:=/nobackup/proj/disk/naiss2025-6-428/from-alvis/tnnls}"
: "${DIAL_CODE_DIR:=${DIAL_BASE}/code/dialdet_reconstruction}"
: "${DIAL_VENV_DIR:=${DIAL_BASE}/code/venv_arrhenius_gh200}"
: "${DIAL_GPU_MODULE:=GPU/buildenv-nvhpc/25.9-cu13.0}"
: "${DIAL_PYTHON_MODULE:=GPU/Python/3.13.5-bare-gcc-2025b-eb}"
: "${DIAL_CPUS:=4}"
: "${DIAL_MEM:=32G}"
: "${DIAL_TIME:=}"
: "${DIAL_DEVICE:=cuda}"

# Detection dataset: coco, crowdhuman, citypersons, or generic.
# COCO is the initial dataset; CrowdHuman uses native full-body ODGT annotations.
: "${DIAL_DATASET:=coco}"

# Required for export. Fill these with EXISTING paths; nothing is downloaded
# implicitly. CrowdHuman requires a compatible, locally supplied checkpoint.
: "${DIAL_IMAGES:=}"
: "${DIAL_ANNOTATIONS:=}"
: "${DIAL_DETECTOR_WEIGHTS:=}"
# Empty chooses 91 for COCO, 2 for CrowdHuman/CityPersons. Must match the checkpoint.
: "${DIAL_NUM_CLASSES:=}"
# CrowdHuman/CityPersons: train or val; empty uses the annotation filename.
: "${DIAL_DATASET_SPLIT:=}"
: "${DIAL_PERSON_CLASS_ID:=1}"
# CityPersons: 0 preserves the published annotation coordinates; use 1 only
# to explicitly convert a separate source whose values are one-based.
: "${DIAL_COORDINATE_ORIGIN:=0}"
# all or reasonable (preparatory target filtering, not an official MR result).
: "${DIAL_CITYPERSONS_SUBSET:=all}"
# Optional export restrictions; empty means the Python default.
: "${DIAL_MAX_IMAGES:=}"
: "${DIAL_SCORE_FLOOR:=}"
: "${DIAL_ROLE:=pool}"

# Required for train/pipeline/full/pilot/infer/evaluate/collect-risk/score-family/tune-local.
: "${DIAL_MANIFEST:=}"
# For infer/collect-risk/score-family/tune-local, or evaluate respectively:
: "${DIAL_CHECKPOINT:=}"
: "${DIAL_PREDICTIONS:=}"
# Evaluation annotation file; empty reuses DIAL_ANNOTATIONS when applicable.
: "${DIAL_EVAL_ANNOTATIONS:=}"
# Pipeline development/tuning annotations; empty reuses evaluation annotations.
# Focal CrowdHuman: annotation_train.odgt here, annotation_val.odgt for evaluation.
: "${DIAL_DEV_ANNOTATIONS:=}"
# Optional official CrowdHuman evaluator checkout (see README_ARRHENIUS.txt).
: "${DIAL_CROWDHUMAN_EVALUATOR:=}"

# A new, absolute directory for this stage. Empty creates a job-specific path.
: "${DIAL_OUTPUT:=}"
: "${DIAL_SEED:=1}"
# Empty: full/pipeline/train=30 epochs; pilot=2. CLI --epochs overrides this.
: "${DIAL_EPOCHS:=}"
# Empty: coco for COCO; iou50 for CrowdHuman/CityPersons; auto for generic.
: "${DIAL_QUALITY_MODE:=}"
: "${DIAL_BUDGETS:=10 25 50 100 200}"
# A single K for collect-risk and tune-local; the paper deploys K=100.
: "${DIAL_BUDGET:=100}"
# Optional solver JSON for train/infer/pipeline/collect-risk.
: "${DIAL_CONFIG:=}"
# score-family uses the already registered policies, including their budget
# and solver settings; DIAL_CONFIG and DIAL_BUDGET do not override that family.
: "${DIAL_POLICY_RECORDS:=}"
# Run specification for paired-statistics. This stage uses CPU evaluation.
: "${DIAL_STATISTICS_SPEC:=}"
# COCO five-seed/two-fold study specification. The JSON spec controls device,
# epochs, seeds, budgets and solver settings; the per-stage options above do
# not override it. `study` only plans unless --execute is explicitly supplied.
: "${DIAL_STUDY_SPEC:=}"
# Checkpoint path for train/pipeline only. Study resume uses explicit --resume.
: "${DIAL_RESUME:=}"
