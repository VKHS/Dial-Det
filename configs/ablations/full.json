{
  "model": {
    "appearance_dim": 128,
    "class_embedding_dim": 16,
    "hidden_dim": 160,
    "layers": 2,
    "heads": 4,
    "overlap_threshold": 0.25,
    "rescue_k": 4,
    "distance_gate": 2.0,
    "rescue_same_class": true,
    "use_appearance": true,
    "use_rescue": true
  },
  "training": {
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "beta": 0.1,
    "gamma": 0.05,
    "assignment_iou": 0.5,
    "gradient_clip": 5.0
  },
  "solver": {
    "rho": 0.08,
    "eta": 0.2,
    "lam": 1.25,
    "p": 2.0,
    "theta": 0.05,
    "exact_limit": 12,
    "beam_width": 64,
    "split_limit": 256,
    "cert_fraction": 0.015,
    "max_cut_rounds": 3,
    "max_cliques": 2048,
    "fallback_threshold": 0.5
  },
  "experiment": {
    "variant": "full",
    "reference_config": "full.json",
    "requires_fresh_training": true,
    "scope": "Controlled component-removal experiment; measured outputs are generated by the configured run."
  }
}
